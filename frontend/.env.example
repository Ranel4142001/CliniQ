# ==============================================================================
# CliniQ Frontend — copy to frontend/.env.local
# ==============================================================================

# Where the Next.js server forwards /api/* requests (server-side only, never sent to the browser)
BACKEND_URL="http://localhost:4000"

# Supabase public values, used by middleware to check the session cookie for page redirects
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
