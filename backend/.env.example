# ==============================================================================
# CliniQ Backend — copy to backend/.env
# ==============================================================================

# HTTP port for the API server
PORT=4000
HOST=0.0.0.0

# PostgreSQL (Supabase or local).
# The backend is a long-running server, so use Supabase's SESSION pooler (port 5432):
# one network round trip per query. The transaction pooler (port 6543, pgbouncer=true)
# is meant for serverless platforms and costs ~4 round trips per query.
# Choose the Supabase region closest to your users; every query pays that distance.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connection_limit=10"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings -> API)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service role key bypasses RLS: server-side only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Required by `npm run db:seed -w backend`. Use strong, unique passwords.
SEED_ADMIN_EMAIL="admin@cliniq.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="System Administrator"
SEED_STAFF_PASSWORD=""
