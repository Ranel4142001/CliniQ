# ==============================================================================
# CliniQ Environment Variables Configuration Template
# Copy this file to .env.local or .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL hosted on Supabase or local PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (port 6543) - used by Prisma Client in runtime
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432) - used by Prisma migrations and CLI
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase Auth & Storage
# ------------------------------------------------------------------------------
# Project URL found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Anon public key found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Service role secret key (NEVER expose to client side)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. Application URL & Environment
# ------------------------------------------------------------------------------
# Public URL of the web app (used for auth redirects and email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 4. Optional Seed Settings (for prisma/seed.ts)
# ------------------------------------------------------------------------------
# Required by `npm run db:seed`. Use strong, unique passwords; never commit real values.
SEED_ADMIN_EMAIL="admin@cliniq.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="System Administrator"
# Password for the seeded clinician and staff accounts
SEED_STAFF_PASSWORD=""

# ------------------------------------------------------------------------------
# 5. Docker Compose only
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=""
